# Russian translation of the Reedach plugin. Not part of the plugin package:
# WordPress.org asks for translations through translate.wordpress.org, import this file there.
msgid ""
msgstr ""
"Project-Id-Version: Reedach\n"
"Language: ru_RU\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"
"X-Domain: reedach\n"

msgid "Style hints for Russian text in the block editor: bureaucratese, clichés, filler words, heavy syntax, typography. The check runs in the browser, the text is not sent anywhere."
msgstr "Подсказки по стилю русского текста в редакторе блоков: канцелярит, штампы, вода, тяжёлый синтаксис, типографика. Проверка идёт в браузере, текст никуда не отправляется."

#. translators: %d: number of suggestions.
msgid "Suggestions: %d"
msgstr "Замечания: %d"

msgid "No suggestions."
msgstr "Замечаний нет."

msgid "Highlight in the text"
msgstr "Подсвечивать в тексте"

#. translators: %s: the suggested word.
msgid "Replace with %s"
msgstr "Заменить на %s"

msgid "Remove"
msgstr "Убрать"

#. translators: %s: the text to remove.
msgid "Remove %s"
msgstr "Убрать %s"

#. translators: %s: the text that goes in.
msgid "Accept “%s”"
msgstr "Принять «%s»"

#. translators: 1: the text in the post, 2: the text that replaces it.
msgid "Replace %1$s with %2$s"
msgstr "Заменить %1$s на %2$s"

msgid "Hints are a guide, not a rule: the choice is yours. The list updates as you type. Click a hint to find it in the text, or a suggested word to put it in."
msgstr "Подсказки — ориентир, а не правило: решать вам. Список обновляется, пока вы пишете. Нажмите на подсказку, чтобы найти её в тексте, или на предложенное слово, чтобы вставить его."

msgid "Settings"
msgstr "Настройки"

msgid "Reedach shows style hints for Russian text in the block editor: open the Reedach panel from the editor toolbar. The check runs in the browser, the text is not sent anywhere."
msgstr "Reedach показывает подсказки по стилю русского текста в редакторе блоков: откройте панель Reedach на верхней панели редактора. Проверка идёт в браузере, текст никуда не отправляется."

msgid "Kinds of hints"
msgstr "Какие подсказки показывать"

msgid "Uncheck what your authors do not need. The setting applies to everyone on the site."
msgstr "Снимите галочки с того, что авторам не нужно. Настройка действует для всех на сайте."

#. translators: %s: link to the project site.
msgid "Rules, sources and the full version with a spelling server: %s"
msgstr "Правила, источники и полная версия с сервером орфографии: %s"
