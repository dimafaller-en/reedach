{
  "name": "reedach-widget",
  "version": "0.2.0",
  "description": "Виджет Reedach: подсказки по русскому тексту прямо в поле ввода на любом сайте — без сервера или с сервером Reedach",
  "license": "MIT",
  "author": "Dima Faller <dima@dimafaller.ru>",
  "homepage": "https://github.com/dimafaller-en/reedach#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimafaller-en/reedach.git",
    "directory": "packages/widget"
  },
  "bugs": "https://github.com/dimafaller-en/reedach/issues",
  "type": "module",
  "sideEffects": [
    "./src/auto.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./auto": "./src/auto.js",
    "./reedach.min.js": "./dist/reedach.min.js",
    "./package.json": "./package.json",
    "./reedach.esm.js": "./dist/reedach.esm.js"
  },
  "files": [
    "src",
    "dist",
    "demo",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "russian",
    "русский",
    "textarea",
    "proofreading",
    "style",
    "widget",
    "spelling"
  ],
  "dependencies": {
    "reedach": "0.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "npm run build:script && npm run build:esm",
    "build:script": "esbuild src/auto.js --bundle --minify --format=iife --target=es2022 --charset=utf8 --legal-comments=none --outfile=dist/reedach.min.js",
    "build:esm": "esbuild src/index.js --bundle --minify --format=esm --target=es2022 --charset=utf8 --legal-comments=none --outfile=dist/reedach.esm.js",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  }
}
